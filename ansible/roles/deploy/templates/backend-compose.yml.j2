services:
  redis:
    image: redis:alpine
    restart: unless-stopped
    ports:
      - "6379:6379"

  worker:
    image: saikamala/worker:v1
    restart: unless-stopped
    depends_on:
      - redis
    environment:
      REDIS_HOST: redis
      DB_HOST: db
      DB_USERNAME: postgres
      DB_PASSWORD: {{ postgres_password | to_json }}
      DB_NAME: postgres
    extra_hosts:
      - "db:{{ postgres_private_ip }}"
