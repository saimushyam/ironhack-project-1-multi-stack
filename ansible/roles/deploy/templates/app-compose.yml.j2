services:
  vote:
    image: pokfinner/vote:latest
    restart: unless-stopped
    ports:
      - "8080:80"
    extra_hosts:
      - "redis:{{ redis_private_ip }}"

  result:
    image: pokfinner/result:latest
    restart: unless-stopped
    ports:
      - "8081:80"
    extra_hosts:
      - "db:{{ postgres_private_ip }}"
